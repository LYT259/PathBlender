{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PathBlender",
  "version": "0.1.5-beta.6",
  "identifier": "org.gh-frc.pathblender",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PathBlender",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 35
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: http: ws:; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMTA2OThFQ0NDOTI2MTEKUldRUkpzbk1qbWtRZzRqZmxpQ2FEU2hQUTgyUDhnUXBzT1UxREJXd3NVUmxqdVU5bWJyVGFKSEwK",
      "endpoints": [
        "https://github.com/LYT259/pathblender/releases/latest/download/latest.json"
      ]
    }
  }
}
